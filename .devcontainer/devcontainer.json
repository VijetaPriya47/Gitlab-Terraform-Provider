// The Dev Container format allows you to configure your environment. At the heart of it
// is a Docker image or Dockerfile which controls the tools available in your environment.
//
// See https://aka.ms/devcontainer.json for more information.
{
	"name": "devcontainer-terraform-provider",
	"image": "mcr.microsoft.com/vscode/devcontainers/base:ubuntu",

	// Features add additional features to your environment. See https://containers.dev/features
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/terraform:1": {
			"version": "1.4.0"
		},
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.26"
		}
	},
	// Extensions for VSCode
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.Go", // for go dev
				"ms-vscode-remote.remote-containers", // devcontainer support
				"GitLab.gitlab-workflow", // gitlab extension
				"hashicorp.terraform", // terraform extension
				"mhutchie.git-graph" // visual git graph for those who want it
			]
		}
	}
}
